Abandoned HTML Card =
VAR CurrentValue =
    [Abandoned]

VAR PreviousValue =
    [Abandoned Previous Month]

VAR MoM =
    [Abandoned MoM %]

VAR IsSingleMonth =
    HASONEVALUE(DateTable[Year Month])

VAR HasPreviousMonth =
    NOT ISBLANK(PreviousValue)

VAR DisplayValue =
    SWITCH(
        TRUE(),
        ISBLANK(CurrentValue), "—",
        ABS(CurrentValue) >= 1000,
            FORMAT(CurrentValue / 1000, "#,##0") & "K",
        FORMAT(CurrentValue, "#,##0")
    )

VAR TrendIcon =
    SWITCH(
        TRUE(),
        NOT IsSingleMonth, "",
        NOT HasPreviousMonth, "—",
        MoM > 0, "↑",
        MoM < 0, "↓",
        "→"
    )

VAR TrendColor =
    SWITCH(
        TRUE(),
        NOT IsSingleMonth, "#6D28D9",
        NOT HasPreviousMonth, "#9CA3AF",

        /* Increase in abandoned calls = negative */
        MoM > 0, "#DC2626",

        /* Decrease in abandoned calls = positive */
        MoM < 0, "#6D28D9",

        "#9CA3AF"
    )

VAR TrendText =
    SWITCH(
        TRUE(),
        NOT IsSingleMonth, "",
        NOT HasPreviousMonth, "No prior month",
        FORMAT(ABS(MoM), "0.0%") & " vs previous month"
    )

RETURN
