        font-weight:600;
        letter-spacing:0.8px;
        color:#111111;
        margin-bottom:7px;
        text-transform:uppercase;
    '>
        AVG ASA
    </div>

    <div style='
        font-size:40px;
        font-weight:700;
        line-height:1;
        color:#111111;
        margin-bottom:9px;
    '>
        " & DisplayValue & "
    </div>

    <div style='
        font-size:20px;
        font-weight:600;
        color:" & TrendColor & ";
        display:flex;
        align-items:center;
        gap:5px;
        white-space:nowrap;
    '>

        <span style='
            font-size:24px;
            font-weight:700;
            line-height:1;
        '>
            " & TrendIcon & "
        </span>

        <span>
            " & TrendText & "
        </span>

    </div>

</div>
"

// ============================================================================
// Operational Rates
// ============================================================================

Abandonment Rate % =
DIVIDE(
    SUM(Call_Center_Data[calls_abandon]),
    SUM(Call_Center_Data[calls_offered])
)

Abandonment Rate Previous Month =
CALCULATE(
    [Abandonment Rate %],
    DATEADD(
        DateTable[Date],
        -1,
        MONTH
    )
)

Abandonment Rate MoM % =
[Abandonment Rate %]
    - [Abandonment Rate Previous Month]
