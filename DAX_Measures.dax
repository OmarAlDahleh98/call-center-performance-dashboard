Avg ASA HTML Card =
VAR CurrentValue =
    [Avg ASA]

VAR PreviousValue =
    [Avg ASA Previous Month]

VAR MoM =
    [Avg ASA MoM %]

VAR IsSingleMonth =
    HASONEVALUE(DateTable[Year Month])

VAR HasPreviousMonth =
    NOT ISBLANK(PreviousValue)

VAR DisplayValue =
    IF(
        ISBLANK(CurrentValue),
        "—",
        FORMAT(CurrentValue, "0.0") & "s"
    )

VAR TrendIcon =
    SWITCH(
        TRUE(),
        NOT IsSingleMonth, "",
        NOT HasPreviousMonth, "—",
        MoM > 0, "↑",
        MoM < 0, "↓",
        "→"
    )

VAR TrendColor =
    SWITCH(
        TRUE(),
        NOT IsSingleMonth, "#6D28D9",
        NOT HasPreviousMonth, "#9CA3AF",

        /* ASA increase = worse */
        MoM > 0, "#DC2626",

        /* ASA decrease = better */
        MoM < 0, "#6D28D9",

        "#9CA3AF"
    )

VAR TrendText =
    SWITCH(
        TRUE(),
        NOT IsSingleMonth, "",
        NOT HasPreviousMonth, "No prior month",
        FORMAT(ABS(MoM), "0.0%") & " vs previous month"
    )

RETURN
"
<div style='
    width:100%;
    height:100%;
    box-sizing:border-box;
    padding:16px 18px;
    background:#FFFFFF;
    border:1px solid #E7E1F0;
    border-radius:12px;
    font-family:Segoe UI, Arial, sans-serif;
    display:flex;
    flex-direction:column;
    justify-content:center;
    overflow:hidden;
    transition:all 0.2s ease;
'
onmouseover='
    this.style.boxShadow=""0 4px 14px rgba(109,40,217,0.14)"";
    this.style.borderColor=""#D8CCF5"";
'
onmouseout='
